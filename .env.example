# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
# GitHub Releases source (defaults: Cunning3D/Cunning3D-Main)
NEXT_PUBLIC_GITHUB_OWNER=
NEXT_PUBLIC_GITHUB_REPO=

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: used for GitHub Releases API (higher rate limit / private repos)
GITHUB_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Showcase Community Upload (GitHub OAuth + PR)
# -----------------------------------------------------------------------------
# Create a GitHub OAuth App and configure the callback URL to:
#   https://your-domain.com/api/showcase/github/callback
#
# Optional: set GITHUB_OAUTH_REDIRECT_URI if you need an explicit URL.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Any long random string (used to encrypt the GitHub access token cookie)
GITHUB_OAUTH_COOKIE_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# Where submissions PRs are opened (owner/repo)
SHOWCASE_SUBMISSIONS_REPO=Cunning3D/Cunning3d_website
# Where CDA examples live inside the repo
SHOWCASE_EXAMPLES_PATH=public/examples
# OAuth scope requested from GitHub (use `repo` for private repos)
SHOWCASE_GITHUB_SCOPE=read:user user:email public_repo

# -----------------------------------------------------------------------------
# Community (Forum + Showcase Likes) via GitHub Issues
# -----------------------------------------------------------------------------
# Optional: central repo for community features (owner/repo). Must have Issues enabled.
COMMUNITY_REPO=
# Optional override: repo used for showcase likes (defaults to COMMUNITY_REPO or SHOWCASE_SUBMISSIONS_REPO)
SHOWCASE_LIKES_REPO=
# Optional override: repo used for forum threads (defaults to COMMUNITY_REPO or SHOWCASE_SUBMISSIONS_REPO)
FORUM_REPO=

# -----------------------------------------------------------------------------
# Showcase Global Counters (CounterAPI.dev)
# -----------------------------------------------------------------------------
# Base URL and namespaces for the public view counters.
# Leave empty to use the defaults:
# - base: https://api.counterapi.dev
# - views namespace: cunning3d_showcase_views
SHOWCASE_VIEWS_COUNTER_API_BASE=
SHOWCASE_VIEWS_NAMESPACE=

# -----------------------------------------------------------------------------
# Donate (External Links)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DONATE_KOFI=
NEXT_PUBLIC_DONATE_PAYPAL=
NEXT_PUBLIC_DONATE_PAYONEER=
NEXT_PUBLIC_DONATE_GITHUB=
NEXT_PUBLIC_DONATE_CRYPTO_ETH=
NEXT_PUBLIC_DONATE_CRYPTO_BTC=
NEXT_PUBLIC_DONATE_CRYPTO_USDT=

# -----------------------------------------------------------------------------
# Webhooks (Ko-fi)
# -----------------------------------------------------------------------------
KOFI_VERIFICATION_TOKEN=

# Optional: write aggregated donation stats back to GitHub (no database)
# If empty, the webhook will only validate + log (no syncing).
DONATIONS_GITHUB_TOKEN=
# Defaults to SHOWCASE_SUBMISSIONS_REPO / COMMUNITY_REPO if empty
DONATIONS_SNAPSHOT_REPO=
DONATIONS_SNAPSHOT_PATH=data/donations.json
DONATIONS_SNAPSHOT_BRANCH=main
# Optional extra secret for hashing donor ids (falls back to KOFI_VERIFICATION_TOKEN)
DONATIONS_HASH_SECRET=

# -----------------------------------------------------------------------------
# Database (MySQL - PlanetScale)
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://root:root@localhost:3306/taxonomy?schema=public"

# -----------------------------------------------------------------------------
# Email (Postmark)
# -----------------------------------------------------------------------------
SMTP_FROM=
POSTMARK_API_TOKEN=
POSTMARK_SIGN_IN_TEMPLATE=
POSTMARK_ACTIVATION_TEMPLATE=

# -----------------------------------------------------------------------------
# Subscriptions (Stripe)
# -----------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PLAN_ID=
